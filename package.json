{
  "name": "davipress",
  "version": "0.2.2",
  "description": "A Markdown documentation framework built on Next.js App Router",
  "license": "MIT",
  "keywords": [
    "nextjs",
    "documentation",
    "markdown",
    "static-site-generator",
    "portfolio"
  ],
  "type": "module",
  "bin": {
    "davipress": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/plugins": {
      "types": "./dist/runtime/plugins.d.ts",
      "import": "./dist/runtime/plugins.js"
    },
    "./runtime/icons": {
      "types": "./dist/runtime/icons.d.ts",
      "import": "./dist/runtime/icons.js"
    },
    "./theme/styles.css": "./dist/runtime/theme.css"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "LICENSE"
  ],
  "scripts": {
    "icons": "node scripts/generate-icon-set.mjs",
    "images": "node scripts/optimize-images.mjs",
    "build": "tsc && node scripts/copy-runtime-assets.mjs",
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build && npm test",
    "dev": "davipress dev",
    "start": "davipress start",
    "clean": "davipress clean"
  },
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/2hjaito/davipress.git"
  },
  "bugs": {
    "url": "https://github.com/2hjaito/davipress/issues"
  },
  "homepage": "https://github.com/2hjaito/davipress#readme",
  "dependencies": {
    "davi-icons": "^0.2.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "next": "^16.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-github-calendar": "^4.5.11",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.0.0"
  }
}
